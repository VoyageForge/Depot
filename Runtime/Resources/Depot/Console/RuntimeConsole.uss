/* ===== 运行时控制台 —— 深色悬浮面板 ===== */

/* 面板根：占屏幕 80% 宽高，由外层 flex 布局居中 */
.console-root {
    position: relative;
    width: 80%;
    height: 80%;
    flex-direction: column;
    background-color: rgba(16, 18, 24, 0.97);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
}

/* ===== 标题栏 ===== */
.console-header {
    height: 46px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 8px;
    background-color: rgb(28, 31, 40);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.console-title {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.console-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: rgb(67, 209, 124);
    margin-right: 8px;
}

.console-title-text {
    font-size: 16px;
    color: rgb(232, 235, 241);
    -unity-font-style: bold;
    margin-right: 8px;
}

.console-title-badge {
    font-size: 12px;
    color: rgb(157, 182, 224);
    background-color: rgba(76, 141, 255, 0.14);
    border-width: 1px;
    border-color: rgba(76, 141, 255, 0.28);
    border-radius: 4px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 1px;
    padding-bottom: 1px;
}

.console-header-spacer {
    flex-grow: 1;
}

.console-header-button {
    height: 28px;
    margin-left: 4px;
    padding-left: 9px;
    padding-right: 9px;
    font-size: 15px;
    color: rgb(139, 146, 161);
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 0;
    border-radius: 5px;
}

.console-header-button:hover {
    background-color: rgba(255, 255, 255, 0.13);
    color: rgb(232, 235, 241);
}

.console-header-close:hover {
    background-color: rgba(240, 90, 90, 0.9);
    color: rgb(255, 255, 255);
}

/* ===== 内容区 ===== */
.console-body {
    position: relative;
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
}

/* ===== 过滤栏 ===== */
.console-filter-bar {
    flex-direction: row;
    align-items: center;
    height: 44px;
    flex-shrink: 0;
    padding-left: 10px;
    padding-right: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.console-filter-button {
    height: 28px;
    margin-right: 6px;
    padding-left: 10px;
    padding-right: 10px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.09);
    border-radius: 14px;
    background-color: rgba(0, 0, 0, 0);
}

.console-filter-button:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.console-filter-button:hover .console-filter-label {
    color: rgb(232, 235, 241);
}

.console-filter-label {
    font-size: 14px;
    color: rgb(141, 146, 161);
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
}

/* 数量角标：圆角胶囊，背景色随级别变化（All/Log 蓝、Warning 琥珀、Error 红） */
.console-filter-count {
    font-size: 13px;
    color: rgb(130, 170, 230);
    margin-left: 6px;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(76, 141, 255, 0.20);
    border-radius: 9px;
}

.console-filter-warning .console-filter-count {
    color: rgb(232, 185, 92);
    background-color: rgba(232, 185, 92, 0.20);
}

.console-filter-error .console-filter-count {
    color: rgb(240, 113, 120);
    background-color: rgba(240, 113, 120, 0.20);
}

.console-filter-button-active {
    background-color: rgb(76, 141, 255);
    border-color: rgb(76, 141, 255);
}

.console-filter-button-active .console-filter-label {
    color: rgb(255, 255, 255);
}

.console-filter-button-active .console-filter-count {
    background-color: rgba(0, 0, 0, 0.20);
    color: rgb(255, 255, 255);
}

.console-filter-button-active.console-filter-warning {
    background-color: rgb(201, 143, 47);
    border-color: rgb(201, 143, 47);
}

.console-filter-button-active.console-filter-error {
    background-color: rgb(207, 82, 82);
    border-color: rgb(207, 82, 82);
}

/* ===== 日志列表 ===== */
.console-list {
    flex-grow: 1;
    min-height: 0;
}

/* 只保留垂直滚动条：隐藏水平滚动条（日志消息自动换行，无需横向滚动） */
.console-list .unity-scroll-view__horizontal-scroller {
    display: none;
}

/* 垂直滚动条容器：固定宽度 */
.console-list .unity-scroll-view__vertical-scroller {
    width: 10px;
}

/* 隐藏滚动条两端的箭头按钮 */
.console-list .unity-scroller__low-button,
.console-list .unity-scroller__high-button {
    display: none;
}

/* 滚动块容器（ScrollerSlider）：宽度填满 scroller */
.console-list .unity-scroller__slider {
    width: 10px;
    max-width: 10px;
    min-width: 0;
}

/* 拖动容器：限制宽度 */
.console-list .unity-base-slider__drag-container {
    width: 10px;
    max-width: 10px;
}

/* 轨道（背景）：淡色圆角，宽度限制 */
.console-list .unity-base-slider__tracker {
    width: 10px;
    max-width: 10px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 5px;
}

/* 滚动块：高对比颜色、圆角、无边框 */
.console-list .unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.55);
    border-radius: 5px;
    border-width: 0;
}

/* 滚动块边框：去掉默认边框 */
.console-list .unity-base-slider__dragger-border {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.console-list .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.75);
}

.console-entry {
    flex-direction: column;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 12px;
    padding-right: 12px;
}

.console-entry:hover {
    background-color: rgba(255, 255, 255, 0.035);
}

.console-entry-line {
    flex-direction: row;
    align-items: flex-start;
}

/* 级别指示圆点：纯色实心，按级别着色，避免与文字颜色混淆 */
.console-entry-dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    flex-shrink: 0;
    margin-top: 6px;   /* 让圆点与首行文字垂直对齐 */
    margin-right: 7px;
    background-color: rgb(96, 130, 180);  /* Log 默认色 */
}

.console-entry-warning .console-entry-dot {
    background-color: rgb(232, 185, 92);
}

.console-entry-error .console-entry-dot {
    background-color: rgb(240, 113, 120);
}

.console-entry-caret {
    width: 8px;
    flex-shrink: 0;
    font-size: 13px;
    color: rgb(93, 100, 114);
    margin-right: 6px;
}

.console-entry-ts {
    flex-shrink: 0;
    font-size: 14px;
    color: rgb(93, 100, 114);
    margin-right: 8px;
}

.console-entry-msg {
    flex-grow: 1;
    font-size: 15px;
    color: rgb(205, 211, 221);
    white-space: normal;
}

.console-entry-warning .console-entry-msg {
    color: rgb(232, 185, 92);
}

.console-entry-error .console-entry-msg {
    color: rgb(240, 113, 120);
}

.console-entry-stack {
    font-size: 14px;
    color: rgb(122, 130, 144);
    white-space: normal;
    margin-top: 3px;
    padding: 6px 10px;
    background-color: rgba(0, 0, 0, 0.28);
    border-left-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.14);
    border-radius: 4px;
}

/* ===== 命令输入 ===== */
.console-command-bar {
    flex-direction: row;
    align-items: center;
    height: 40px;
    flex-shrink: 0;
    padding-left: 12px;
    padding-right: 12px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.05);
    background-color: rgba(0, 0, 0, 0.22);
}

.console-command-prompt {
    font-size: 15px;
    color: rgb(76, 141, 255);
    margin-right: 8px;
}

.console-command-input {
    flex-grow: 1;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.console-command-input .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(232, 235, 241);
    font-size: 15px;
    --unity-cursor-color: rgb(255, 255, 255);
}

/* ===== 命令扫描 loading ===== */
.console-loading-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(16, 18, 24, 0.72);
}

.console-loading-spinner {
    width: 28px;
    height: 28px;
    border-width: 3px;
    border-color: rgba(76, 141, 255, 0.25);
    border-top-color: rgb(76, 141, 255);
    border-radius: 14px;
    margin-bottom: 10px;
}

.console-loading-text {
    font-size: 14px;
    color: rgb(157, 166, 181);
}

/* ===== 命令补全建议 ===== */
.console-suggestions {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 40px;
    flex-direction: column;
    background-color: rgb(24, 27, 34);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    border-radius: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.console-suggestion-item {
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 14px;
    color: rgb(205, 211, 221);
}

.console-suggestion-item:hover {
    background-color: rgba(76, 141, 255, 0.22);
    color: rgb(255, 255, 255);
}

.console-suggestion-item-selected {
    background-color: rgba(76, 141, 255, 0.34);
    color: rgb(255, 255, 255);
}
