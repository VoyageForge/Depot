<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Depot/Runtime/Resources/Depot/Console/RuntimeConsole.uss?fileID=7433441132597879392&amp;guid=3a7e608edb0c4ad794134dce816a82f4&amp;type=3#RuntimeConsole" />
    <ui:VisualElement name="console-root" class="console-root">
        <ui:VisualElement name="console-header" class="console-header">
            <ui:VisualElement class="console-title">
                <ui:VisualElement class="console-status-dot" />
                <ui:Label text="Console" class="console-title-text" />
                <ui:Label text="DEPOT" class="console-title-badge" />
            </ui:VisualElement>
            <ui:VisualElement name="console-header-spacer" class="console-header-spacer" />
            <ui:Button name="console-close-button" text="×" class="console-header-button console-header-close" />
        </ui:VisualElement>
        <ui:VisualElement name="console-body" class="console-body">
            <ui:VisualElement name="console-filter-bar" class="console-filter-bar">
                <ui:VisualElement name="filter-all" class="console-filter-button">
                    <ui:Label text="All" class="console-filter-label" />
                    <ui:Label text="0" class="console-filter-count" />
                </ui:VisualElement>
                <ui:VisualElement name="filter-log" class="console-filter-button">
                    <ui:Label text="Log" class="console-filter-label" />
                    <ui:Label text="0" class="console-filter-count" />
                </ui:VisualElement>
                <ui:VisualElement name="filter-warning" class="console-filter-button console-filter-warning">
                    <ui:Label text="Warning" class="console-filter-label" />
                    <ui:Label text="0" class="console-filter-count" />
                </ui:VisualElement>
                <ui:VisualElement name="filter-error" class="console-filter-button console-filter-error">
                    <ui:Label text="Error" class="console-filter-label" />
                    <ui:Label text="0" class="console-filter-count" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ListView name="console-list" class="console-list" />
            <ui:VisualElement name="console-command-bar" class="console-command-bar">
                <ui:Label text="›" class="console-command-prompt" />
                <ui:TextField name="console-command-input" class="console-command-input" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
